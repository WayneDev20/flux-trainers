# Copy to .env (gitignored) and fill in. Never commit .env.

# ── RunPod (primary GPU platform) ───────────────────────────────────────────
RUNPOD_API_KEY=

# ── Anthropic (VLM captioning in tools/caption_dataset.py) ──────────────────
ANTHROPIC_API_KEY=

# ── Cloudflare R2 (three buckets) ───────────────────────────────────────────
# mirror-writer token — for running mirror_flux_weights.py from laptop
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_WEIGHTS_MIRROR=flux-weights-mirror
R2_BUCKET_DATASETS=avatar-datasets
R2_BUCKET_LORAS=avatar-loras

# ── Webhooks ────────────────────────────────────────────────────────────────
# Shared between handler + avatar-backend receiver. Generate with:
#   openssl rand -hex 32
WEBHOOK_HMAC_SECRET=

# ── Sentry (error tracking) ─────────────────────────────────────────────────
SENTRY_DSN=

# ── GHCR (container registry) ───────────────────────────────────────────────
# Leave blank — handled by `gh auth login` / `docker login ghcr.io`.
GITHUB_ORG=Concept-fashion-ML

# ── FLUX weights version pin (ADR-0003) ─────────────────────────────────────
FLUX_WEIGHTS_VERSION=v1
